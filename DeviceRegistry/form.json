{
    "elements": [
        {
            "type": "Label",
            "caption": "Single Source of Truth - Zentrale Verwaltung für alle Geräte im Haus."
        },
        {
            "type": "Button",
            "caption": "Geräte automatisch suchen (Auto-Discovery)",
            "onClick": "SDR_DiscoverDevices($id);"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Räume & Gebäude",
            "items": [
                {
                    "type": "List",
                    "name": "Rooms",
                    "caption": "Verfügbare Räume",
                    "add": true,
                    "delete": true,
                    "columns": [
                        {"caption": "Raum Name", "name": "name", "width": "200px", "add": "", "edit": {"type": "ValidationTextBox"}},
                        {"caption": "Etage / Bereich", "name": "floor", "width": "200px", "add": "", "edit": {"type": "ValidationTextBox"}}
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
