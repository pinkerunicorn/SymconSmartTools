                    "add": true,
                    "delete": true,
                    "columns": [
                        {"caption": "Name", "name": "name", "width": "200px", "add": "", "edit": {"type": "ValidationTextBox"}},
                        {"caption": "Raum", "name": "room", "width": "150px", "add": "", "edit": {"type": "Select", "options": []}},
                        {"caption": "OnOff Variable", "name": "OnOff_VarID", "width": "auto", "add": 0, "edit": {"type": "SelectVariable"}},
                        {"caption": "Status", "name": "Status", "width": "150px", "add": ""}
