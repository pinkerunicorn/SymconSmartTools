{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "StationID",
            "caption": "Station ID (z.B. 91001930 für München, Untermenzing)"
        },
        {
            "type": "ValidationTextBox",
            "name": "WantedLine",
            "caption": "Gewünschte Linie (z.B. S 2)"
        },
        {
            "type": "ValidationTextBox",
            "name": "ExcludeDestinations",
            "caption": "Auszuschließende Ziele (kommagetrennt, z.B. Petershausen, Altomünster)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update Intervall (Sekunden)",
            "minimum": 10
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Inaktiv (Station ID fehlt)" },
        { "code": 200, "icon": "error", "caption": "Fehler" },
        { "code": 201, "icon": "error", "caption": "Verbindungsfehler" }
    ],
    "actions": [
        {
            "type": "Button",
            "label": "Jetzt aktualisieren",
            "onClick": "MVV_Update($id);"
        }
    ]
}
