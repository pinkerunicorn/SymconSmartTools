                },
                {
                    "type": "PasswordTextBox",
                    "name": "PinCode",
                    "caption": "PIN Code (fuer OAuth-Login)",
                    "width": "200px"
                }
            ]
        },
        {
            "type": "Label",
            "caption": " "
        },
        {
            "type": "SelectModule",
            "name": "RegistryID",
