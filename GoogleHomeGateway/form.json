{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Google Home Zugangsdaten",
            "expanded": false,
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "GoogleClientID",
                    "caption": "OAuth Client ID",
                    "width": "400px"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "GoogleClientSecret",
                    "caption": "OAuth Client Secret",
                    "width": "400px"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "ServiceAccountJSON",
                    "caption": "Service Account JSON (fuer Report State)",
                    "width": "400px"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "PinCode",
                    "caption": "PIN Code (fuer OAuth-Login)",
                    "width": "200px"
                }
            ]
        },
        {
            "type": "Label",
            "caption": " "
        },
        {
            "type": "SelectModule",
            "name": "RegistryID",
            "caption": "Device Registry",
            "moduleID": "{F3B4A7D9-C59E-401A-B826-17D3B5C2849E}"
        },
        {
            "type": "Label",
            "caption": "Wähle hier die Device Registry Instanz aus. Das Gateway synchronisiert automatisch alle dort gepflegten Geräte mit Google Home."
        },
        {
            "type": "Label",
            "caption": " "
        },
        {
            "type": "ExpansionPanel",
            "caption": "Geräte-Freigabe (Auswahl für Google Home)",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Wähle hier aus, welche Geräte an Google Home übergeben werden sollen."
                },
                {
                    "type": "List",
                    "name": "DeviceFilter",
                    "add": false,
                    "delete": false,
                    "sort": {
                        "column": "name",
                        "direction": "ascending"
                    },
                    "columns": [
                        {
                            "caption": "Aktiv",
                            "name": "sync",
                            "width": "80px",
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Name",
                            "name": "name",
                            "width": "auto",
                            "save": true
                        },
                        {
                            "caption": "Kategorie",
                            "name": "type",
                            "width": "200px",
                            "save": true
                        },
                        {
                            "caption": "ID (intern)",
                            "name": "id",
                            "width": "0px",
                            "visible": false,
                            "save": true
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Google Sync anfordern (nach Änderungen)",
            "onClick": "GHGW_RequestSync($id);"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Google Home Gateway ist aktiv"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Google Home Gateway ist inaktiv (Zugangsdaten fehlen)"
        }
    ]
}
