{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Google Home Zugangsdaten",
            "expanded": false,
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "GoogleClientID",
                    "caption": "OAuth Client ID",
                    "width": "400px"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "GoogleClientSecret",
                    "caption": "OAuth Client Secret",
                    "width": "400px"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "HomeGraphAPIKey",
                    "caption": "Home Graph API Key",
                    "width": "400px"
                },
                {
                    "type": "PasswordTextBox",
                    "name": "PinCode",
                    "caption": "PIN Code (fuer OAuth-Login)",
                    "width": "200px"
                }
            ]
        },
        {
            "type": "Label",
            "caption": " "
        },
        {
            "type": "ExpansionPanel",
            "caption": "Schalter",
            "expanded": true,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesSwitch",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "200px", "add": "Neues Geraet", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Schaltvariable", "name": "OnOff_VarID", "width": "400px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [0, 1] } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Steckdose",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesSocket",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "200px", "add": "Neue Steckdose", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Schaltvariable", "name": "OnOff_VarID", "width": "400px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [0, 1] } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Licht (Schalter)",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesLight",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "200px", "add": "Neues Licht", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Schaltvariable", "name": "OnOff_VarID", "width": "400px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [0, 1] } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Licht (Dimmer)",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesLightDimmer",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "200px", "add": "Neuer Dimmer", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Schaltvariable", "name": "OnOff_VarID", "width": "250px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [0, 1] } },
                        { "caption": "Helligkeit", "name": "Brightness_VarID", "width": "250px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [1, 2] } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Licht (Farbe)",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesLightColor",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "180px", "add": "Neue Farblampe", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "An/Aus", "name": "OnOff_VarID", "width": "150px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [0, 1] } },
                        { "caption": "Helligkeit", "name": "Brightness_VarID", "width": "150px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [1, 2] } },
                        { "caption": "Farbe RGB", "name": "ColorRGB_VarID", "width": "150px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [1] } },
                        { "caption": "Farbtemperatur", "name": "ColorTemp_VarID", "width": "150px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [1] } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Rollladen / Jalousien",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesBlind",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "200px", "add": "Neue Rolllade", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Oeffnen/Schliessen", "name": "OpenClose_VarID", "width": "400px", "add": 0, "edit": { "type": "SelectVariable", "validVariableTypes": [0, 1, 2] } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Thermostat",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesThermostat",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "200px", "add": "Neues Thermostat", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Szenen (deaktivierbar)",
            "expanded": false,
            "items": [
                {
                    "type": "List",
                    "name": "DevicesScene",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "sort": { "column": "name", "direction": "ascending" },
                    "columns": [
                        { "caption": "Name", "name": "name", "width": "200px", "add": "Neue Szene", "edit": { "type": "ValidationTextBox" } },
                        { "caption": "Aktion beim Aktivieren", "name": "ActionOn", "width": "300px", "add": "{}", "edit": { "type": "SelectAction" } },
                        { "caption": "Aktion beim Deaktivieren", "name": "ActionOff", "width": "300px", "add": "{}", "edit": { "type": "SelectAction" } },
                        { "caption": "Status", "name": "Status", "width": "100px", "add": "OK", "edit": { "type": "Label" } }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "SYNC anfordern (nach Aenderungen)",
            "onClick": "GHGW_RequestSync($id); echo 'SYNC angefordert!';"
        },
        {
            "type": "Button",
            "caption": "Alle Zustaende pushen (Report State)",
            "onClick": "GHGW_ReportAllStates($id); echo 'Report State gesendet!';"
        }
    ]
}
