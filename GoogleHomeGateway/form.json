        },
        {
            "type": "Label",
            "caption": "Wähle hier die Device Registry Instanz aus. Das Gateway synchronisiert automatisch alle dort gepflegten Geräte mit Google Home."
        },
        {
            "type": "Label",
            "caption": " "
        },
        {
            "type": "ExpansionPanel",
            "caption": "Geräte-Filter (Blacklist)",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "Geräte, die in dieser Liste stehen, werden NICHT an Google Home gesendet."
                },
                {
                    "type": "List",
                    "name": "Blacklist",
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Gerät (aus Registry)",
                            "name": "id",
                            "width": "400px",
                            "add": "",
                            "edit": {
                                "type": "Select",
                                "options": []
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Google Sync anfordern (nach Änderungen)",
