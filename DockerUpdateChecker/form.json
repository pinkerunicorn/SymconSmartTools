{
    "elements": [
        {
            "type": "Select",
            "name": "Channel",
            "caption": "Update-Kanal (Tag)",
            "options": [
                { "label": "Stable (stable)", "value": "stable" },
                { "label": "Beta (beta)", "value": "beta" },
                { "label": "Testing (testing)", "value": "testing" },
                { "label": "Latest (latest)", "value": "latest" }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Prüf-Intervall (Sekunden)",
            "minimum": 3600
        },
        {
            "type": "SelectScript",
            "name": "UpdateScript",
            "caption": "Update-Skript (wird bei Klick ausgeführt)"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "label": "Jetzt prüfen",
            "onClick": "SDU_Update($id);"
        }
    ]
}
